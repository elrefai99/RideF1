{
  "name": "chat",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \" nodemon -L\" \"npx ts-node ./backend/Queue/worker.ts\"",
    "build": "tsc",
    "start": "concurrently \"node ./dist/backend/app.js\" \"node ./dist/backend/Queue/worker.js\"",
    "test": "jest --detectOpenHandles --runInBand",
    "test:local": "NODE_ENV=development jest",
    "taze:local": "npx taze -r",
    "taze:back": "npx taze major",
    "taze:update": "npx taze major -w",
    "taze:patch": "npx taze patch",
    "compress:ubuntu": "sudo zip -r project.zip .",
    "gen:app": "gen-import --app-config --map",
    "gen:check": "gen-import --strict=cycles"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "jwt": "^0.2.0",
    "mongoose": "^9.11.1",
    "nodemon": "^3.1.14",
    "socket.io": "^4.8.4",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.4",
    "@mohamed-elrefai/tsconfigs": "^1.0.2",
    "@types/node": "^26.6.5",
    "fastify": "^5.12.7",
    "gen-import": "^2.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
