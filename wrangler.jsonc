{
     "$schema": "./node_modules/wrangler/config-schema.json",
     "name": "gin-api",
     "main": "cloudflare/index.ts",
     "compatibility_date": "2026-10-15",
     "containers": [
          {
               "class_name": "GinContainer",
               "image": "./app/api/Dockerfile",
               "max_instances": 3
          }
     ],
     "durable_objects": {
          "bindings": [
               {
                    "name": "GIN_CONTAINER",
                    "class_name": "GinContainer"
               }
          ]
     },
     "migrations": [
          {
               "tag": "v1",
               "new_sqlite_classes": [
                    "GinContainer"
               ]
          }
     ]
}
